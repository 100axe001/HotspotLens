<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	No app sandbox: the app needs to run /usr/sbin/arp, /usr/sbin/ndp,
	/sbin/ifconfig as regular (unprivileged) subprocesses and read the
	bootpd lease file, none of which the sandbox permits even
	read-only. Privileged operations still never happen in this process --
	see HotspotLensHelper, which is the actual privilege boundary.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
