<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	No app sandbox: the helper must run pfctl and write to
	/Library/Application Support/HotspotLensHelper, which sandboxing would
	block. It is still restricted by running as a minimal, single-purpose
	daemon that only accepts connections from the code-signature-verified
	main app (see main.swift) -- sandboxing isn't the boundary here,
	"does one narrow thing and checks its caller" is.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
